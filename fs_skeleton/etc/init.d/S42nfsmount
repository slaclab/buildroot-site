#! /bin/sh
#
# NFS mount
#

case "$1" in
  start)
	echo "Mounting NFS..."
	# Mount the NFS entries with mount.nfs ourselves to get
	# 4.2 -> 4.1 -> 4.0 -> 3 negotiated as /bin/mount defaults to v3.
	awk '$1 !~ /^#/ && $3 ~ /^nfs/ && $4 !~ /^[0-9]*$/ \
	     && $4 !~ /(^|,)noauto(,|$)/ { print $1, $2, $4 }' /etc/fstab |
	while read -r dev mnt opts; do
		# skip if already mounted, or repeated starts would stack mounts
		awk -v m="$mnt" '$2 == m { f = 1 } END { exit !f }' /proc/mounts && continue
		/sbin/mount.nfs "$dev" "$mnt" -o "$opts" ||
			echo "Failed to mount $dev on $mnt"
	done
	# Mount non NFS filesystems defined in fstab
	/bin/mount -a
	;;
  stop)
	echo -n "Unmounting NFS..."
	# Both types are needed: a v4 mount is recorded in /proc/mounts as
	# "nfs4" even when fstab said "nfs", and busybox matches -t exactly.
	/bin/umount -a -f -t nfs,nfs4
	;;
  restart|reload)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
