#! /bin/sh
#
# fstab generation
#
# /proc/cmdline will provide the following parameters:
#  1. ROOTMNT=SRV:REMOTE_PATH:MNTPT
#     This defines the mount.
#  2. ROOTTYPE=nfs|nfs4|...
#     Defines the file system type (defaults to nfs)
#  3. ROOTOPTS=vers=3,rw,...
#     These are mount options
#

case "$1" in
    start)
        MO=`cat /proc/cmdline | grep -Eo 'ROOTOPTS=\S+' | sed 's/ROOTOPTS=//g'`
        FT=`cat /proc/cmdline | grep -Eo 'ROOTTYPE=\S+' | cut -d '=' -f2`
        ROOTMNT=`cat /proc/cmdline | grep -Eo 'ROOTMNT=\S+' | cut -d '=' -f2`

        if [ -z "${ROOTMNT}" ]; then
            echo "No ROOTMNT= in /proc/cmdline; falling back to DHCP"
            exit 0
        fi

        [ -z "${FT}" ] && FT=nfs

        # Append NFS specific options
        case "${FT}" in
            nfs|nfs4)
                [ ! -z "${MO}" ] && MO="${MO},"
                MO="${MO}ro,nolock,noresvport,noac,soft"
                ;;
            *)
                ;;
        esac

        # Ensure the mount point actually exists
        mkdir -p "`echo ${ROOTMNT} | cut -d ':' -f3`"

        echo "# WARNING! LINES BELOW HERE AUTOGENERATED BY $0 vvvvv" >> /etc/fstab
        echo "`echo ${ROOTMNT} | cut -d ':' -f 1,2` `echo ${ROOTMNT} | cut -d ':' -f3` ${FT} ${MO} 0 0" >> /etc/fstab
        ;;

    restart|stop)
        ;;

    *)
        usage "$0 start|stop|restart"
        exit 1
        ;;
esac