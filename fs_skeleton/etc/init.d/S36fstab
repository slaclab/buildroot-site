#! /bin/sh
#
# fstab generation
#
# /proc/cmdline will provide the following parameters:
#  1. ROOTMNT=SRV:REMOTE_PATH:MNTPT
#     This defines the mount.
#  2. ROOTTYPE=nfs|nfs4|nfs4.1...
#     Defines the file system type (defaults to nfs)
#  3. ROOTOPTS=vers=4,rw,...
#     These are mount options
#

case "$1" in
    start)
        MO=`cat /proc/cmdline | grep -Eo 'ROOTOPTS=\S+' | sed 's/ROOTOPTS=//g'`
        FT=`cat /proc/cmdline | grep -Eo 'ROOTTYPE=\S+' | cut -d '=' -f2-`
        ROOTMNT=`cat /proc/cmdline | grep -Eo 'ROOTMNT=\S+' | cut -d '=' -f2-`

        if [ -z "${ROOTMNT}" ]; then
            echo "No ROOTMNT= in /proc/cmdline; falling back to DHCP"
            exit 0
        fi

        [ -z "${FT}" ] && FT=nfs

        case "${FT}" in
            # Append NFSv4-specific defaults and forces version to 4.1
            nfs4.1)
                if [ -z "${MO}" ]; then
                    MO="vers=4.1,timeo=150,ro,nolock,noresvport,hard,noatime"
                fi
                # nfs4.1 is not a valid mount option
                FT="nfs4"
                ;;
            # Append NFSv4-specific defaults and let negotiation retrieve the
            # best version available
            nfs4)
                if [ -z "${MO}" ]; then
                    MO="timeo=150,ro,nolock,noresvport,hard,noatime"
                fi
                ;;
            # NFS v3 needs different parameters. Negotiation with the NFS
            # server can still mount it as NFS v4. If v4 is really expected,
            # the recommendation is to use nfs4 or nfs4.1 in ROOTTYPE to get
            # the right ROOTOPTS.
            nfs)
                if [ -z "${MO}" ]; then
                    MO="ro,nolock,noresvport,noac,soft"
                fi
                ;;
            *)
                ;;
        esac

        # Ensure the mount point actually exists
        mkdir -p "`echo ${ROOTMNT} | cut -d ':' -f3`"

        echo "#AUTOGENERATED_CMDLINE: THE LINES BELOW HERE AUTOGENERATED BY $0" >> /etc/fstab
        echo "`echo ${ROOTMNT} | cut -d ':' -f 1,2` `echo ${ROOTMNT} | cut -d ':' -f3` ${FT} ${MO} 0 0" >> /etc/fstab
        ;;

    restart|stop)
        ;;

    *)
        usage "$0 start|stop|restart"
        exit 1
        ;;
esac
