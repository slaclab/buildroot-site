#! /bin/sh
#
# fstab generation
#
# /proc/cmdline will provide the following parameters:
#  1. ROOTMNT=SRV:REMOTE_PATH:MNTPT
#     This defines the mount.
#  2. ROOTTYPE=nfs|nfs4
#     Selects the mount option profile (defaults to nfs). It does NOT pin the
#     protocol version: mount.nfs negotiates 4.2 -> 4.1 -> 4.0 -> 3.
#  3. ROOTOPTS=rw,...
#     These are mount options, and replace the profile entirely. An explicit
#     vers= here defeats negotiation; vers=4 in particular pins 4.0.
#

case "$1" in
    start)
        MO=`cat /proc/cmdline | grep -Eo 'ROOTOPTS=\S+' | sed 's/ROOTOPTS=//g'`
        FT=`cat /proc/cmdline | grep -Eo 'ROOTTYPE=\S+' | cut -d '=' -f2-`
        ROOTMNT=`cat /proc/cmdline | grep -Eo 'ROOTMNT=\S+' | cut -d '=' -f2-`

        if [ -z "${ROOTMNT}" ]; then
            echo "No ROOTMNT= in /proc/cmdline; falling back to DHCP"
            exit 0
        fi

        [ -z "${FT}" ] && FT=nfs

        case "${FT}" in
            # nfs4, and legacy nfs4.1 from not-yet-updated boot configs, only
            # select the v4 option profile. No vers= is emitted so that
            # mount.nfs is free to negotiate the best version the server
            # offers. The type is normalised to nfs because mount.nfs never
            # rewrites it, and -t nfs4 cannot take the final v3 rung.
            nfs4*)
                if [ -z "${MO}" ]; then
                    MO="timeo=150,retrans=2,ro,nolock,noresvport,hard,noatime"
                fi
                FT="nfs"
                ;;
            # Conservative options for servers expected to be v3-era. These
            # still negotiate up to v4 if the server supports it.
            nfs)
                if [ -z "${MO}" ]; then
                    MO="ro,nolock,noresvport,noac,soft"
                fi
                ;;
            *)
                ;;
        esac

        # Ensure the mount point actually exists
        mkdir -p "`echo ${ROOTMNT} | cut -d ':' -f3`"

        echo "#AUTOGENERATED_CMDLINE: THE LINES BELOW HERE AUTOGENERATED BY $0" >> /etc/fstab
        echo "`echo ${ROOTMNT} | cut -d ':' -f 1,2` `echo ${ROOTMNT} | cut -d ':' -f3` ${FT} ${MO} 0 0" >> /etc/fstab
        ;;

    restart|stop)
        ;;

    *)
        usage "$0 start|stop|restart"
        exit 1
        ;;
esac
