#! /bin/sh
#
# fstab generation
#
# /proc/cmdline will provide the following parameters:
#  1. ROOTMNT=SRV:REMOTE_PATH:MNTPT
#     This defines the mount.
#  2. ROOTTYPE=nfs|nfs4
#     Selects the mount option profile (defaults to nfs). It does NOT pin the
#     protocol version: mount.nfs negotiates 4.2 -> 4.1 -> 4.0 -> 3.
#  3. ROOTOPTS=rw,...
#     These are mount options, and replace the profile entirely. An explicit
#     vers= here defeats negotiation; vers=4 in particular pins 4.0.
#

case "$1" in
    start)
        # Don't duplicate if start is called more than once.
        if grep -q '#AUTOGENERATED_CMDLINE:' /etc/fstab; then
            exit 0
        fi

        # '(^| )' keeps MYROOTMNT= and the like from matching as a suffix;
        # 'tail -1' selects only one result from a repeated  parameter, like
        # ROOTOPTS=x,y,z ROOTOPTS=a,b,c.
        cmdline_param() {
            grep -Eo "(^| )$1=\S+" /proc/cmdline | tail -1 | cut -d '=' -f2-
        }

        MO=`cmdline_param ROOTOPTS`
        FT=`cmdline_param ROOTTYPE`
        ROOTMNT=`cmdline_param ROOTMNT`

        if [ -z "${ROOTMNT}" ]; then
            echo "No ROOTMNT= in /proc/cmdline; falling back to DHCP"
            exit 0
        fi

        # ROOTMNT has to be SRV:REMOTE_PATH:MNTPT.
        case "${ROOTMNT}" in
            *:*:*) ;;
            *)
                echo "Malformed ROOTMNT=${ROOTMNT}; expected SRV:REMOTE_PATH:MNTPT"
                exit 1
                ;;
        esac

        [ -z "${FT}" ] && FT=nfs

        # Shared with site.script so both fstab generators agree. Guarded
        # because sourcing a missing file aborts the script under ash.
        [ -r /etc/default/nfsprofiles ] && . /etc/default/nfsprofiles

        case "${FT}" in
            # nfs4, and legacy nfs4.1 from not-yet-updated boot configs, only
            # select the v4 option profile. The type is normalised to nfs
            # because mount.nfs never rewrites it, and -t nfs4 cannot take
            # the final v3 rung.
            nfs4*)
                if [ -z "${MO}" ]; then
                    MO="${NFS_V4_OPTS}"
                fi
                FT="nfs"
                ;;
            nfs)
                if [ -z "${MO}" ]; then
                    MO="${NFS_V3_OPTS}"
                fi
                ;;
            *)
                ;;
        esac

        # Ensure the mount point actually exists
        mkdir -p "`echo ${ROOTMNT} | cut -d ':' -f3`"

        echo "#AUTOGENERATED_CMDLINE: THE LINES BELOW HERE AUTOGENERATED BY $0" >> /etc/fstab
        echo "`echo ${ROOTMNT} | cut -d ':' -f 1,2` `echo ${ROOTMNT} | cut -d ':' -f3` ${FT} ${MO} 0 0" >> /etc/fstab
        ;;

    restart|stop)
        ;;

    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
