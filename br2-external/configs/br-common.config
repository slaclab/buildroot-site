BR2_DL_DIR="$(TOPDIR)/../download"
BR2_HOST_DIR="${shell cd $(TOPDIR)/../; pwd}/host/linux-${shell X=`uname -p`; case $$X in i?86 ) echo x86 ;; * ) echo $$X ;; esac}/$(BR2_ARCH)"
BR2_ENABLE_DEBUG=y
BR2_EXTERNAL="$(TOPDIR)/site/br2-external"
BR2_OPTIMIZE_2=y
BR2_GLOBAL_PATCH_DIR="$(TOPDIR)/site/pkg-patches/"
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TOOLCHAIN_BUILDROOT_FORTRAN=y
BR2_PACKAGE_MPFR=y
BR2_PACKAGE_HOST_GDB=y
BR2_ROOTFS_DEVICE_TABLE="site/device_table.txt"
BR2_ROOTFS_OVERLAY="site/fs_skeleton"
BR2_ROOTFS_POST_BUILD_SCRIPT="site/scripts/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="site/scripts/pack_img.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.16"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_LINUX_KERNEL_PATCH="https://cdn.kernel.org/pub/linux/kernel/projects/rt/6.12/older/patch-6.12.16-rt9.patch.gz $(BR2_GLOBAL_PATCH_DIR)linux/$(BR2_LINUX_KERNEL_VERSION)/*.diff"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="linux-$(BR2_LINUX_KERNEL_VERSION).config"
BR2_PACKAGE_BUSYBOX_CONFIG="site/config/bb-1.37.x.config"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_MPG123=y
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GLIBC_UTILS=y
BR2_PACKAGE_LSOF=y
BR2_PACKAGE_LTRACE=y
BR2_PACKAGE_MEMSTAT=y
BR2_PACKAGE_RT_TESTS=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_IPMITOOL=y
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_USB_MODESWITCH=y
BR2_PACKAGE_LIBCAP=y
BR2_PACKAGE_LINUX_TOOLS_PERF=y
BR2_PACKAGE_READLINE=y
BR2_PACKAGE_BRIDGE_UTILS=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_MII_DIAG=y
BR2_PACKAGE_NETCAT=y
BR2_PACKAGE_NTP=y
BR2_PACKAGE_NTP_NTPDATE=y
BR2_PACKAGE_NTP_NTPDC=y
BR2_PACKAGE_NTP_NTPQ=y
BR2_PACKAGE_NTP_TICKADJ=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_SCREEN=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_LIBFUSE=y
BR2_PACKAGE_PSMISC=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_AUTOSCAN=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_WPS=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_GZIP=y
BR2_TARGET_ROOTFS_EXT2_SIZE="80M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_SUDO=y
BR2_PACKAGE_DMIDECODE=y

# These are all needed by eudev and usbip:

BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# BR2_PACKAGE_TBTOOLS is not set
# BR2_PACKAGE_ZFS is not set
# BR2_PACKAGE_IGT_GPU_TOOLS is not set
# BR2_PACKAGE_WESTON is not set
# BR2_PACKAGE_BCACHE_TOOLS is not set
# BR2_PACKAGE_BIOSDEVNAME is not set
# BR2_PACKAGE_BRICKD is not set
# BR2_PACKAGE_DT_UTILS is not set
# BR2_PACKAGE_ESPFLASH is not set
BR2_PACKAGE_EUDEV=y
BR2_PACKAGE_PROVIDES_UDEV="eudev"
BR2_PACKAGE_EUDEV_MODULE_LOADING=y
# BR2_PACKAGE_EUDEV_RULES_GEN is not set
BR2_PACKAGE_EUDEV_ENABLE_HWDB=y
# BR2_PACKAGE_LEDMON is not set
BR2_PACKAGE_HAS_UDEV=y
# BR2_PACKAGE_UDISKS is not set
# BR2_PACKAGE_UPOWER is not set
BR2_PACKAGE_USBIP=y
# BR2_PACKAGE_USBMOUNT is not set
# BR2_PACKAGE_USBUTILS is not set
# BR2_PACKAGE_HIDAPI is not set
# BR2_PACKAGE_LIBATASMART is not set
# BR2_PACKAGE_LIBBLOCKDEV is not set
# BR2_PACKAGE_LIBGUDEV is not set
# BR2_PACKAGE_LIBINPUT is not set
# BR2_PACKAGE_NETWORK_MANAGER is not set
BR2_PACKAGE_KMOD=y
# BR2_PACKAGE_KMOD_TOOLS is not set
# BR2_PACKAGE_LIBVIRT is not set
# BR2_PACKAGE_MULTIPATH_TOOLS is not set
# BR2_PACKAGE_PETITBOOT is not set
# BR2_PACKAGE_THERMALD is not set
BR2_PACKAGE_UTIL_LINUX_LIBS=y
BR2_PACKAGE_UTIL_LINUX_LIBBLKID=y
BR2_PACKAGE_HOST_EUDEV=y
